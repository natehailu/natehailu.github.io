  steps:[['Map','fill and waitlists for every class time'],['Ask','who relies on the quiet times first'],['Test','one change for 4 weeks, then compare']]},
 nums:{feel:'"Honestly, I don\'t really know my numbers."',
  now:'Money comes in and classes fill, but nobody has time to pull it together. You run on feel, and you\'re not always sure it\'s right.',
  data:'This sample letter puts the month on one page, with every total added up so you can check it.',jump:'s-nums',
  want:'Once a month you\'d see clients, fill, intro conversions and revenue in plain words, with clear next steps.',
  why:['Reports are scattered across screens','Nobody knows which numbers matter most','Pulling it together takes hours','Months don\'t compare because definitions change'],
  ask:'If you could know three things about your studio every month, what would they be?',
  f:[['h','Hours a month you spend on reports and spreadsheets (your estimate)',4],['r','What an hour of your time is worth ($)',40]],
  out:v=>[v.h*v.r],say:(v,r)=>`<b>${fmt(v.h)}</b> hours × <b>$${fmt(v.r)}</b> = <span class="big">$${fmt(r[0])} a month</span>of your time on numbers, by your estimate.`,
  steps:[['Pick','the three to five numbers that matter'],['Define','them the same way every month'],['Review','them on a set day, with next steps']]}
};
function fmt(x,d){d=d||0;return Number(x).toLocaleString('en-US',{minimumFractionDigits:d,maximumFractionDigits:d})}
const path=document.getElementById('path'),steps=document.getElementById('steps');let cur='miss';
function render(k){cur=k;const p=P[k];
 document.querySelectorAll('.chip').forEach(c=>c.setAttribute('aria-pressed',c.dataset.p===k?'true':'false'));
 const f=p.f.map(([id,lab,val])=>`<label for="f-${k}-${id}">${lab}<input id="f-${k}-${id}" type="number" inputmode="decimal" min="0" step="any" value="${val}"></label>`).join('');
 path.innerHTML=`
 <div class="beat"><div class="k">Sound familiar?</div><p class="quote">${p.feel}</p><p>${p.now}</p></div>
 <div class="beat"><div class="k">What it looks like in a studio's data</div><p>${p.data}</p><button class="jump" type="button">See it in the sample letter</button></div>
 <div class="beat"><div class="k">What you'd want instead</div><p>${p.want}</p></div>
 <div class="beat"><div class="k">What's usually behind it</div><p>It looks the same everywhere. The reason is different in every studio:</p><ul>${p.why.map(w=>`<li>${w}</li>`).join('')}</ul><div class="ask"><b>WORTH ASKING YOURSELF</b>${p.ask}</div></div>
 <div class="beat"><div class="k">What it may be costing you</div><p>Use your own estimates. Nothing here is a promise, and nothing is sent anywhere.</p>
  <div class="calc"><div class="fields">${f}</div><div class="result" id="res"></div><div class="caveat">Example values are filled in; change them to yours. This is gross revenue based on your estimate, not profit, and no report can promise to change it.</div></div></div>`;
 steps.innerHTML=p.steps.map(([b,t])=>`<div><b>${b.toUpperCase()}</b>${t}</div>`).join('');
 path.querySelectorAll('input').forEach(i=>i.addEventListener('input',calc));
 path.querySelector('.jump').addEventListener('click',()=>jump(p.jump));
 calc();}
function calc(){const p=P[cur],v={};p.f.forEach(([id])=>{const n=parseFloat(document.getElementById(`f-${cur}-${id}`).value);v[id]=isFinite(n)&&n>=0?n:0});document.getElementById('res').innerHTML=p.say(v,p.out(v))}
function jump(id){const el=document.getElementById(id);if(!el)return;document.querySelectorAll('.hl').forEach(x=>x.classList.remove('hl'));el.classList.add('hl');el.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'start'})}
document.querySelectorAll('.chip').forEach(c=>c.addEventListener('click',()=>render(c.dataset.p)));
const toast=document.getElementById('toast');
function copy(text,msg,node){const ok=()=>toast.textContent=msg;try{navigator.clipboard.writeText(text).then(ok,()=>sel(node))}catch(e){sel(node)}}
function sel(node){if(!node){toast.textContent='Select the text to copy it.';return}const r=document.createRange();r.selectNodeContents(node);const s=getSelection();s.removeAllRanges();s.addRange(r);toast.textContent='Selected. Use copy on your device.'}
document.getElementById('copyNum').addEventListener('click',()=>copy('(832) 507-6699','Number copied.',document.querySelector('.phone')));
document.getElementById('copyLink').addEventListener('click',()=>copy(location.href.split('#')[0],'Link copied. Send it to whoever helps you decide.',null));
render('miss');

const times=['6am','9:30am','Noon','4:30pm','5:30pm','7pm'];
const days=[['Mon',[70,90,40,60,100,80]],['Tue',[80,70,30,70,'100w',90]],['Wed',[60,60,20,50,90,70]],['Thu',[80,80,30,70,'100w',90]],['Fri',[70,90,50,null,60,null]],['Sat',[null,'100w',90,null,null,null]]];
const g=document.getElementById('heat'),tip=document.getElementById('tip');
const step=v=>v>=95?5:v>=80?4:v>=60?3:v>=40?2:1;
let h='<div></div>'+times.map(t=>`<div class="hd">${t}</div>`).join('');
days.forEach(([d,vals])=>{h+=`<div class="rl">${d}</div>`;vals.forEach((raw,i)=>{
 if(raw===null){h+=`<div class="cell none">–</div>`;return}
 const w=String(raw).endsWith('w'),v=parseInt(raw,10),s=step(v),ink=s>=4?'var(--hiInk)':'var(--ink)';
 h+=`<div class="cell num" tabindex="0" data-t="${d} ${times[i]} · about ${Math.round(v/10)} of 10 reformers${w?' · usually a waitlist':''}" style="background:var(--h${s});color:${ink}">${v}%${w?'<span class="wl">W</span>':''}</div>`})});
g.innerHTML=h;
g.querySelectorAll('.cell[data-t]').forEach(c=>{const on=()=>{const r=c.getBoundingClientRect();tip.textContent=c.dataset.t;tip.hidden=false;tip.style.left=(r.left+r.width/2)+'px';tip.style.top=r.top+'px'};
 c.addEventListener('pointerenter',on);c.addEventListener('focus',on);c.addEventListener('pointerdown',on);c.addEventListener('pointerleave',()=>tip.hidden=true);c.addEventListener('blur',()=>tip.hidden=true)});
window.addEventListener('scroll',()=>tip.hidden=true,{passive:true});
})();
</script>

