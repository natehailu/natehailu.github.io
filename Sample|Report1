  out:v=>[v.g*v.d],say:(v,r)=>`If <b>${fmt(v.g)}</b> more of your <b>${fmt(v.n)}</b> intro clients joined each month at <b>$${fmt(v.d)}</b>, that's <span class="big">$${fmt(r[0])} a month</span>in gross revenue for each month's group, by your estimate. It's a what-if, not a forecast.`,
  steps:[['Watch','who reaches 3 classes during the intro'],['Invite','each of them personally before it ends'],['Measure','conversion at the same point every month']]},
 packs:{feel:'"Clients buy packs and then don\'t use them."',
  now:'Packs expire with classes left. Some clients feel bad about it and don\'t buy another, and you only find out when they\'re gone.',
  data:'In this sample, 11 clients had packs ending late October with 41 paid classes left.',jump:'s-packs',
  want:'Each month you\'d see whose pack is ending with classes left, early enough to send a friendly nudge so they use what they paid for.',
  why:['Nobody sees expiry dates coming','Clients forget they have classes left','Their usual class time filled up','No reminder goes out before the pack ends'],
  ask:'Do you know right now whose packs end this month?',
  f:[['c','Unused classes expiring in a typical month (your estimate)',40],['p','Price per class in a pack ($)',25]],
  out:v=>[v.c*v.p],say:(v,r)=>`<b>${fmt(v.c)}</b> classes × <b>$${fmt(v.p)}</b> = <span class="big">$${fmt(r[0])} a month</span>of paid classes going unused, by your estimate. Unused classes can make clients less likely to buy again.`,
  steps:[['List','packs ending in the next few weeks with classes left'],['Remind','with a friendly note and a class suggestion'],['Check','who renews after using their classes']]},
 class:{feel:'"Some classes have a waitlist, others are half empty."',
  now:'Clients get turned away at 5:30, while the noon instructor teaches to a few people. You\'d like to change the schedule, but you\'re not sure it\'s safe.',
  data:'In this sample, Tue and Thu 5:30pm ran full with waitlists while weekday noon ran 20 to 50% full.',jump:'s-class',
  want:'You\'d see fill and waitlists for every class time, try one change, and know within a month whether it worked.',
  why:['The schedule hasn\'t changed while clients\' lives have','One instructor or time draws everyone','Nobody measures fill by class time','Waitlisted clients give up and don\'t come back'],
  ask:'Which class time would you change if you knew it was safe?',
